# --- Supabase -----------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> Database -> Connection string -> Transaction pooler
DATABASE_URL=postgresql://postgres.your-project:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- App ----------------------------------------------------------------------
# Every canonical URL, sitemap entry, and og:image is resolved against this. Set
# it to the real origin in production or they all point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The address the privacy and terms pages name as the way to reach the site.
# Unset falls back to hello@example.com, which is fine locally and wrong in
# production — those pages are legally required to name a real one.
NEXT_PUBLIC_CONTACT_EMAIL=

# The token from Search Console's "HTML tag" verification method — just the
# content value, not the whole tag. Optional: leave unset and no tag is emitted.
# Set it only on production, so a preview deployment cannot claim the domain.
GOOGLE_SITE_VERIFICATION=

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored provider credential unreadable.
CREDENTIALS_ENCRYPTION_KEY=

# Shared secret for the Vercel Cron endpoints.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Paddle (payments) --------------------------------------------------------
# Merchant of record for the dofollow upgrade and sponsor slots. Leave the
# whole block unset and the site keeps its "checkout is not available" state
# rather than rendering buy buttons that would throw.
#
# Paddle replaced Polar because Polar settles to sellers over Stripe Connect
# Express, which does not cover Georgia. Paddle is a merchant of record too, so
# it takes the same job on: it bills the customer, handles VAT, and pays out.

# "sandbox" (default) or "production". Two separate deployments with their own
# keys, tokens and price ids — switching this means swapping all of them.
PADDLE_ENV=sandbox
# Server-side API key. Paddle -> Developer tools -> Authentication -> API keys.
# Sandbox keys start pdl_sdbx_apikey_, live ones pdl_live_apikey_.
PADDLE_API_KEY=
# Client-side token from the same page. Reaches the browser by design — it is
# what Paddle.js uses to open the checkout, and it can do nothing else.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Paddle -> Developer tools -> Notifications -> your destination. Paddle signs
# every delivery with this; the webhook is the only place a purchase is granted.
PADDLE_WEBHOOK_SECRET=
# Price ids (pri_...), not product ids: Paddle checks out a price, and a product
# can hold several. A price left unset is simply not sold.
PADDLE_PRICE_DOFOLLOW=
PADDLE_PRICE_SPONSOR=

# --- Testing (optional) -------------------------------------------------------
# Stripe TEST secret key, used only by scripts/stripe-test-data.ts to create a
# fake subscription book. Never a live key.
STRIPE_TEST_KEY=

# --- Vibecode verdicts --------------------------------------------------------
# Drafts the "Can I vibecode it?" assessment on each app page. Verdicts are
# cached in the database and never generated while rendering a page, so the site
# serves them without this key — but both `npm run vibecode` and the admin
# dashboard's "generate verdict" action need it to write new ones.
OPENAI_API_KEY=
