{
  "name": "trustmrrforios",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:policies": "tsx --tsconfig tsconfig.scripts.json scripts/apply-policies.ts",
    "role": "tsx --tsconfig tsconfig.scripts.json scripts/set-role.ts",
    "db:seed": "tsx --tsconfig tsconfig.scripts.json scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:policies && npm run db:seed",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\"",
    "db:reference": "tsx --tsconfig tsconfig.scripts.json scripts/seed-reference.ts",
    "stripe:testdata": "tsx --tsconfig tsconfig.scripts.json scripts/stripe-test-data.ts",
    "db:demo": "tsx --tsconfig tsconfig.scripts.json scripts/seed-demo.ts",
    "db:simulate": "tsx --tsconfig tsconfig.scripts.json scripts/simulate-verification.ts",
    "polar:products": "tsx --tsconfig tsconfig.scripts.json scripts/polar-products.ts",
    "polar:reconcile": "tsx --tsconfig tsconfig.scripts.json scripts/polar-reconcile.ts",
    "polar:reset": "tsx --tsconfig tsconfig.scripts.json scripts/reset-purchases.ts",
    "vibecode": "tsx --tsconfig tsconfig.scripts.json scripts/vibecode-verdicts.ts",
    "aso": "tsx --tsconfig tsconfig.scripts.json scripts/aso-score.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@polar-sh/sdk": "^0.49.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.109.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "next": "15.5.23",
    "p-limit": "^7.3.1",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
